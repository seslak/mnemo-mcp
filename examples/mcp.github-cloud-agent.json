{
  "mcpServers": {
    "mnemo": {
      "type": "stdio",
      "command": "python",
      "args": [
        "mnemo/server.py"
      ],
      "env": {
        "MNEMO_FILE": "mnemo/memory.json",
        "MNEMO_WORKSPACE_ROOT": "."
      },
      "tools": [
        "mnemo_search",
        "mnemo_recent",
        "mnemo_compact_context",
        "mnemo_lookup_symbol"
      ]
    }
  }
}
